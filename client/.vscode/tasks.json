{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/std:c++17",
                "/Zi",
                "/EHsc",
                "/nologo",
                "/MD",
                "${file}",
                "glad.c",
                "/Fe${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe",
                "/I${workspaceFolder}\\include",
                "/IC:\\Tools",
                "/link",
                "/LIBPATH:${workspaceFolder}\\lib", "glfw3.lib",
                "opengl32.lib",
                "user32.lib",
                "gdi32.lib",
                "shell32.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}